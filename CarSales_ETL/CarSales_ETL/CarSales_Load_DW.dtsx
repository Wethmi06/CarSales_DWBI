    <DTS:Executable
      DTS:refId="Package\Load Dim_Date (SQL)"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{17EC82D1-1A6E-44E2-9BA8-A00A06A8BDA9}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="Load Dim_Date (SQL)"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{AEAD2958-72C8-4EA0-995F-B9A64DD815A1}"
          SQLTask:SqlStatementSource="INSERT INTO dbo.Dim_Date&#xA;(&#xA;    Date_Key,&#xA;    Full_Date,&#xA;    Day,&#xA;    Month,&#xA;    Month_Name,&#xA;    Quarter,&#xA;    Year,&#xA;    Day_of_Week,&#xA;    Is_Weekend&#xA;)&#xA;SELECT DISTINCT&#xA;    YEAR(Sale_Date) * 10000 + MONTH(Sale_Date) * 100 + DAY(Sale_Date) AS Date_Key,&#xA;    CAST(Sale_Date AS DATE) AS Full_Date,&#xA;    DAY(Sale_Date) AS [Day],&#xA;    MONTH(Sale_Date) AS [Month],&#xA;    DATENAME(MONTH, Sale_Date) AS Month_Name,&#xA;    'Q' + CAST(DATEPART(QUARTER, Sale_Date) AS VARCHAR(1)) AS Quarter,&#xA;    YEAR(Sale_Date) AS [Year],&#xA;    DATENAME(WEEKDAY, Sale_Date) AS Day_of_Week,&#xA;    CASE &#xA;        WHEN DATENAME(WEEKDAY, Sale_Date) IN ('Saturday','Sunday') THEN 1&#xA;        ELSE 0&#xA;    END AS Is_Weekend&#xA;FROM CarSales_Staging.dbo.Stg_Sales s&#xA;WHERE NOT EXISTS&#xA;(&#xA;    SELECT 1&#xA;    FROM dbo.Dim_Date d&#xA;    WHERE d.Full_Date = CAST(s.Sale_Date AS DATE)&#xA;);" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
