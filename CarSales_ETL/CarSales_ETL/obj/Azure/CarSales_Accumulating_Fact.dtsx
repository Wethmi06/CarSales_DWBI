      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{EF0DC7EA-06B0-47CF-B276-4A2DD26A5A58}"
          SQLTask:SqlStatementSource="UPDATE f&#xA;SET &#xA;    f.accm_txn_complete_time = s.accm_txn_complete_time,&#xA;    f.txn_process_time_hours =&#xA;        DATEDIFF(MINUTE, f.accm_txn_create_time, s.accm_txn_complete_time) / 60.0&#xA;FROM dbo.Fact_Sales f&#xA;JOIN CarSales_Staging.dbo.Stg_Completion s&#xA;    ON f.Sale_ID = s.Sale_ID;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
